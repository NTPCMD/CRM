# AgencyOS environment variables — copy to .env.local and fill in.
# .env.local is git-ignored; never commit real secrets.

# --- Supabase (client-safe) ---
# The URL and the *publishable* (anon) key are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase (server-only SECRETS — do NOT prefix with NEXT_PUBLIC) ---
# Needed for server-side admin actions (inviting users, webhooks, cron).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by `supabase db push` / migrations.
SUPABASE_DB_URL=

# --- AI Gateway (Volume 4/5) ---
ANTHROPIC_API_KEY=
# Optional additional providers the gateway can route to:
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# --- Payments (Volume 4) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Volume 5) ---
RESEND_API_KEY=
# or POSTMARK_SERVER_TOKEN=
